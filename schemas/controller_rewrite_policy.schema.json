{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Controller Rewrite Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "enabled", "llm", "constraints"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "fallback_to_deterministic",
        "command",
        "max_neighbors"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "fallback_to_deterministic": {
          "type": "boolean"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_neighbors": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_rule_words",
        "max_rule_words",
        "require_normative_modal",
        "require_verification_phrase"
      ],
      "properties": {
        "min_rule_words": {
          "type": "integer",
          "minimum": 3
        },
        "max_rule_words": {
          "type": "integer",
          "minimum": 3
        },
        "require_normative_modal": {
          "type": "boolean"
        },
        "require_verification_phrase": {
          "type": "boolean"
        }
      }
    }
  }
}
