{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Citation Grounding Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "max_iso_citations_per_guideline",
    "max_std_refs_per_guideline",
    "min_total_markers",
    "max_repeated_anchor_sentences",
    "disallow_generic_anchor_phrase_repeat",
    "iso_templates",
    "std_ref_defaults_by_topic",
    "std_ref_fallbacks",
    "anchor_sentence_templates"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "max_iso_citations_per_guideline": {
      "type": "integer",
      "minimum": 1
    },
    "max_std_refs_per_guideline": {
      "type": "integer",
      "minimum": 1
    },
    "min_total_markers": {
      "type": "integer",
      "minimum": 1
    },
    "max_repeated_anchor_sentences": {
      "type": "integer",
      "minimum": 0
    },
    "disallow_generic_anchor_phrase_repeat": {
      "type": "boolean"
    },
    "iso_templates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_seed", "fallback"],
      "properties": {
        "from_seed": {
          "type": "string",
          "minLength": 1
        },
        "fallback": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "std_ref_defaults_by_topic": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/stringList"
      }
    },
    "std_ref_fallbacks": {
      "$ref": "#/$defs/stringList"
    },
    "anchor_sentence_templates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iso", "std"],
      "properties": {
        "iso": {
          "$ref": "#/$defs/stringList"
        },
        "std": {
          "$ref": "#/$defs/stringList"
        }
      }
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
