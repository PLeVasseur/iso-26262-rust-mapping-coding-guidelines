{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Controller Decision Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "session_id",
    "iteration",
    "generated_at",
    "observation_summary",
    "deficits_summary",
    "candidates",
    "alignment_overrides"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "iteration": {
      "type": "integer",
      "minimum": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "observation_summary": {
      "type": "object"
    },
    "deficits_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["deficit_id", "type", "severity", "distance_to_pass"],
        "properties": {
          "deficit_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "guideline_id": {
            "type": "string"
          },
          "target_id": {
            "type": "string"
          },
          "distance_to_pass": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "actions", "pre_score", "risk_penalty"],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "pre_score": {
            "type": "number"
          },
          "risk_penalty": {
            "type": "number",
            "minimum": 0
          },
          "mutation_footprint_estimate": {
            "type": "integer",
            "minimum": 0
          },
          "bundle_signature": {
            "type": "string"
          },
          "expected_lane_deltas": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          }
        }
      }
    },
    "suppressed_signatures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "historical_signatures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "alignment_overrides": {
      "type": "object"
    },
    "policy_context": {
      "type": "object"
    }
  }
}
