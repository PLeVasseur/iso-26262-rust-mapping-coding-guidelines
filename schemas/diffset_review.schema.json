{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Diffset Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "diffset_id", "reviewer", "reviewed_at", "items"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "diffset_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "verdict", "comment", "status", "updated_at"],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "type": "string",
            "enum": ["accept", "needs_change", "block"]
          },
          "comment": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["open", "resolved"]
          },
          "updated_at": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
