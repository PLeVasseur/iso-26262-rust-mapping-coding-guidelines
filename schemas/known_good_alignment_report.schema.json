{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Known Good Alignment Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "generated_at",
    "benchmark_pack_id",
    "active_tier",
    "gate_mode",
    "thresholds",
    "guideline_count",
    "average_alignment_score",
    "warning_count",
    "error_count",
    "guideline_results",
    "warnings",
    "errors",
    "ok"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_pack_id": {
      "type": "string",
      "minLength": 1
    },
    "active_tier": {
      "type": "string",
      "enum": ["strict", "extended", "all"]
    },
    "gate_mode": {
      "type": "string",
      "enum": ["warn", "error"]
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": true
    },
    "guideline_count": {
      "type": "integer",
      "minimum": 0
    },
    "average_alignment_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "warning_count": {
      "type": "integer",
      "minimum": 0
    },
    "error_count": {
      "type": "integer",
      "minimum": 0
    },
    "guideline_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ok": {
      "type": "boolean"
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guideline_id",
        "alignment_score",
        "dimension_scores",
        "flags",
        "feature_values"
      ],
      "properties": {
        "guideline_id": {
          "type": "string",
          "minLength": 1
        },
        "alignment_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dimension_scores": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "feature_values": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "known_good_alignment_gap",
              "granularity_too_coarse",
              "granularity_too_fine",
              "example_depth_too_shallow",
              "citation_coverage_low",
              "benchmark_similarity_gap"
            ]
          }
        },
        "nearest_neighbors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["guideline_id", "similarity"],
            "properties": {
              "guideline_id": {
                "type": "string",
                "minLength": 1
              },
              "similarity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    }
  }
}
