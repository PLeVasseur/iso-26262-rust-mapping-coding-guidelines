{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Alignment Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "benchmark_paths",
    "active_tier",
    "gate_mode",
    "thresholds",
    "weights",
    "advisory_similarity"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "benchmark_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_path", "canonical_dir", "baseline_path"],
      "properties": {
        "manifest_path": {
          "type": "string",
          "minLength": 1
        },
        "canonical_dir": {
          "type": "string",
          "minLength": 1
        },
        "baseline_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "active_tier": {
      "type": "string",
      "enum": ["strict", "extended", "all"]
    },
    "gate_mode": {
      "type": "string",
      "enum": ["warn", "error"]
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_global_alignment",
        "min_changed_guideline_alignment",
        "granularity_outliers_allowed"
      ],
      "properties": {
        "min_global_alignment": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_changed_guideline_alignment": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "granularity_outliers_allowed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structure", "specificity", "evidence", "citations", "granularity"],
      "properties": {
        "structure": {
          "type": "number",
          "minimum": 0
        },
        "specificity": {
          "type": "number",
          "minimum": 0
        },
        "evidence": {
          "type": "number",
          "minimum": 0
        },
        "citations": {
          "type": "number",
          "minimum": 0
        },
        "granularity": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "advisory_similarity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "min_similarity"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "min_similarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "controller_progression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "start_iteration",
        "target_iteration",
        "start_thresholds",
        "target_thresholds",
        "start_gate_mode",
        "target_gate_mode"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "start_iteration": {
          "type": "integer",
          "minimum": 1
        },
        "target_iteration": {
          "type": "integer",
          "minimum": 1
        },
        "start_thresholds": {
          "$ref": "#/$defs/progressionThresholds"
        },
        "target_thresholds": {
          "$ref": "#/$defs/progressionThresholds"
        },
        "start_gate_mode": {
          "type": "string",
          "enum": ["warn", "error"]
        },
        "target_gate_mode": {
          "type": "string",
          "enum": ["warn", "error"]
        }
      }
    }
  },
  "$defs": {
    "progressionThresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_global_alignment",
        "min_changed_guideline_alignment",
        "granularity_outliers_allowed"
      ],
      "properties": {
        "min_global_alignment": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_changed_guideline_alignment": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "granularity_outliers_allowed": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
