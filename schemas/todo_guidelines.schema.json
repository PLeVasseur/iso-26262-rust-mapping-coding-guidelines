{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Guideline Backlog v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "guidelines"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "guidelines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "technical_topic",
          "rule_statement",
          "amplification",
          "exceptions",
          "rationale",
          "iso_seeds",
          "scope",
          "decidable",
          "decidability_rationale",
          "state",
          "enforcement_mode",
          "enforcement_details",
          "evidence_artifacts",
          "deviation_requirements",
          "examples"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "category": {
            "type": "string",
            "enum": ["Mandatory", "Required", "Advisory", "Disapplied"]
          },
          "technical_topic": {"type": "string", "minLength": 1},
          "rule_statement": {"type": "string", "minLength": 1},
          "amplification": {"type": "string", "minLength": 1},
          "exceptions": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1},
          "iso_seeds": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "scope": {
            "type": "string",
            "enum": ["system", "crate", "module"]
          },
          "decidable": {
            "type": "string",
            "enum": ["decidable", "undecidable"]
          },
          "decidable_status": {
            "type": "string",
            "enum": [
              "compiler",
              "clippy",
              "possible-with-clippy",
              "impossible-with-clippy"
            ]
          },
          "decidability_rationale": {"type": "string", "minLength": 1},
          "clippy_lint_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "clippy_lint_url": {
            "type": "string",
            "format": "uri"
          },
          "clippy_candidate_tracker": {
            "type": "string",
            "format": "uri"
          },
          "state": {
            "type": "string",
            "enum": ["DRAFT", "TRIAL", "ENFORCED", "DEPRECATED"]
          },
          "enforcement_mode": {
            "type": "string",
            "enum": ["AUTO", "AUDIT", "HYBRID"]
          },
          "enforcement_details": {"type": "string", "minLength": 1},
          "evidence_artifacts": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "deviation_requirements": {"type": "string", "minLength": 1},
          "examples": {
            "type": "object",
            "additionalProperties": false,
            "required": ["non_compliant", "compliant"],
            "properties": {
              "non_compliant": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code_path",
                  "doc_path",
                  "explanation",
                  "compile_expectation"
                ],
                "properties": {
                  "code_path": {"type": "string", "minLength": 1},
                  "doc_path": {"type": "string", "minLength": 1},
                  "explanation": {"type": "string", "minLength": 1},
                  "compile_expectation": {
                    "type": "string",
                    "enum": ["compile_fail", "compile_pass", "documented-only"]
                  },
                  "expectation_exception_reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "compliant": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code_path",
                  "doc_path",
                  "explanation",
                  "compile_expectation"
                ],
                "properties": {
                  "code_path": {"type": "string", "minLength": 1},
                  "doc_path": {"type": "string", "minLength": 1},
                  "explanation": {"type": "string", "minLength": 1},
                  "compile_expectation": {
                    "type": "string",
                    "enum": ["compile_pass", "no_run", "documented-only"]
                  }
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "decidable": {"const": "undecidable"}
              },
              "required": ["decidable"]
            },
            "then": {
              "not": {
                "anyOf": [
                  {"required": ["decidable_status"]},
                  {"required": ["clippy_lint_id"]},
                  {"required": ["clippy_lint_url"]},
                  {"required": ["clippy_candidate_tracker"]}
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "decidable": {"const": "decidable"}
              },
              "required": ["decidable"]
            },
            "then": {
              "required": ["decidable_status"]
            }
          },
          {
            "if": {
              "properties": {
                "decidable_status": {"const": "clippy"}
              },
              "required": ["decidable_status"]
            },
            "then": {
              "required": ["clippy_lint_id", "clippy_lint_url"]
            }
          },
          {
            "if": {
              "properties": {
                "decidable_status": {"const": "possible-with-clippy"}
              },
              "required": ["decidable_status"]
            },
            "then": {
              "required": ["clippy_candidate_tracker"]
            }
          },
          {
            "if": {
              "properties": {
                "decidable_status": {"const": "compiler"}
              },
              "required": ["decidable_status"]
            },
            "then": {
              "anyOf": [
                {
                  "properties": {
                    "examples": {
                      "properties": {
                        "non_compliant": {
                          "properties": {
                            "compile_expectation": {
                              "const": "compile_fail"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "properties": {
                    "examples": {
                      "properties": {
                        "non_compliant": {
                          "required": ["expectation_exception_reason"],
                          "properties": {
                            "compile_expectation": {
                              "enum": ["compile_pass", "documented-only"]
                            }
                          }
                        }
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
