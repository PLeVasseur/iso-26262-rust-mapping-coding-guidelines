{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Known Good Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "pack_id",
    "source_repo",
    "source_sha",
    "generated_at",
    "selection_policy",
    "guideline_count",
    "guidelines"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "pack_id": {
      "type": "string",
      "minLength": 1
    },
    "source_repo": {
      "type": "string",
      "minLength": 1
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{7,40}$"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "selection_policy": {
      "type": "object",
      "additionalProperties": true
    },
    "guideline_count": {
      "type": "integer",
      "minimum": 0
    },
    "guidelines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/manifestEntry"
      }
    }
  },
  "$defs": {
    "manifestEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guideline_id",
        "chapter",
        "source_path",
        "local_rst_path",
        "tier",
        "title",
        "signals"
      ],
      "properties": {
        "guideline_id": {
          "type": "string",
          "pattern": "^gui_[A-Za-z0-9]+$"
        },
        "chapter": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "local_rst_path": {
          "type": "string",
          "minLength": 1
        },
        "local_md_path": {
          "type": "string"
        },
        "local_canonical_path": {
          "type": "string"
        },
        "tier": {
          "type": "string",
          "enum": ["strict", "extended"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "signals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "has_rationale",
            "has_compliant_example",
            "has_non_compliant_example",
            "has_citation_signal",
            "has_bibliography_signal",
            "has_todo_signal"
          ],
          "properties": {
            "has_rationale": {
              "type": "boolean"
            },
            "has_compliant_example": {
              "type": "boolean"
            },
            "has_non_compliant_example": {
              "type": "boolean"
            },
            "has_citation_signal": {
              "type": "boolean"
            },
            "has_bibliography_signal": {
              "type": "boolean"
            },
            "has_todo_signal": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
