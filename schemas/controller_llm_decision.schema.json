{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Controller LLM Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selected_candidate_ids",
    "rationale",
    "risk_notes",
    "confidence",
    "fallback_recommended"
  ],
  "properties": {
    "selected_candidate_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rejected_candidate_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "risk_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "fallback_recommended": {
      "type": "boolean"
    }
  }
}
