{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Controller Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "session_id",
    "status",
    "recommendation",
    "reason",
    "mode",
    "corpus_pack",
    "run_id",
    "consecutive_successes",
    "required_success_window",
    "lane_status",
    "delta_summary",
    "generated_at"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["running", "success", "blocked", "error"]
    },
    "recommendation": {
      "type": "string",
      "enum": ["ready", "needs_review", "blocked"]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": ["change", "growth"]
    },
    "corpus_pack": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string"
    },
    "consecutive_successes": {
      "type": "integer",
      "minimum": 0
    },
    "required_success_window": {
      "type": "integer",
      "minimum": 1
    },
    "last_iteration_decision": {
      "type": "string"
    },
    "last_selected_by": {
      "type": "string",
      "enum": ["none", "deterministic", "llm", "fallback"]
    },
    "last_selection_reason": {
      "type": "string"
    },
    "last_commit_sha": {
      "type": "string"
    },
    "decision_fallback_count": {
      "type": "integer",
      "minimum": 0
    },
    "lane_status": {
      "type": "object"
    },
    "delta_summary": {
      "type": "object"
    },
    "validation_errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    }
  }
}
