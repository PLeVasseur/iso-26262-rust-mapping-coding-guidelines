{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Controller LLM Rewrite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_statement",
    "amplification",
    "exceptions",
    "rationale",
    "citation_plan",
    "uniqueness_rationale",
    "confidence"
  ],
  "properties": {
    "rule_statement": {
      "type": "string",
      "minLength": 1
    },
    "amplification": {
      "type": "string",
      "minLength": 1
    },
    "exceptions": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "citation_plan": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "uniqueness_rationale": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "examples": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compliant": {
          "$ref": "#/$defs/exampleSide"
        },
        "non_compliant": {
          "$ref": "#/$defs/exampleSide"
        }
      }
    }
  },
  "$defs": {
    "exampleSide": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "expected_outcome": {
          "type": "string",
          "enum": [
            "assertion_pass",
            "compile_fail",
            "runtime_panic",
            "lint_trigger",
            "documented_only"
          ]
        },
        "verification_notes": {
          "type": "string",
          "minLength": 1
        },
        "markdown": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
