{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Example Quality Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "gate_mode",
    "require_expected_outcome",
    "documented_only_requires_verification_notes",
    "require_assertion_for_assertion_pass",
    "allowed_outcomes",
    "thresholds"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "gate_mode": {
      "type": "string",
      "enum": ["warn", "error"]
    },
    "require_expected_outcome": {
      "type": "boolean"
    },
    "documented_only_requires_verification_notes": {
      "type": "boolean"
    },
    "require_assertion_for_assertion_pass": {
      "type": "boolean"
    },
    "allowed_outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compliant", "non_compliant"],
      "properties": {
        "compliant": {
          "$ref": "#/$defs/outcomeList"
        },
        "non_compliant": {
          "$ref": "#/$defs/outcomeList"
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_outcome_match_ratio",
        "min_assertion_backed_compliant_ratio",
        "min_negative_evidence_strength_ratio",
        "max_documented_only_ratio",
        "min_unique_example_signature_ratio",
        "max_repeated_example_signature_count"
      ],
      "properties": {
        "min_outcome_match_ratio": {
          "$ref": "#/$defs/ratio"
        },
        "min_assertion_backed_compliant_ratio": {
          "$ref": "#/$defs/ratio"
        },
        "min_negative_evidence_strength_ratio": {
          "$ref": "#/$defs/ratio"
        },
        "max_documented_only_ratio": {
          "$ref": "#/$defs/ratio"
        },
        "min_unique_example_signature_ratio": {
          "$ref": "#/$defs/ratio"
        },
        "max_repeated_example_signature_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "$defs": {
    "ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "outcome": {
      "type": "string",
      "enum": [
        "assertion_pass",
        "compile_fail",
        "runtime_panic",
        "lint_trigger",
        "documented_only"
      ]
    },
    "outcomeList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/outcome"
      }
    }
  }
}
