{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Guideline Diversity Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "gate_mode",
    "exact_duplicate",
    "near_duplicate",
    "lead_in",
    "lexical_diversity"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "gate_mode": {
      "type": "string",
      "enum": ["warn", "error"]
    },
    "exact_duplicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_groups"],
      "properties": {
        "max_groups": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "near_duplicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "similarity_threshold",
        "max_violation_pairs",
        "allow_near_duplicate_with_distinct_obligation_unit",
        "require_verification_constraint_divergence",
        "min_verification_constraint_delta_count",
        "disallow_near_duplicate_within_same_rule_family"
      ],
      "properties": {
        "similarity_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_violation_pairs": {
          "type": "integer",
          "minimum": 0
        },
        "allow_near_duplicate_with_distinct_obligation_unit": {
          "type": "boolean"
        },
        "require_verification_constraint_divergence": {
          "type": "boolean"
        },
        "min_verification_constraint_delta_count": {
          "type": "integer",
          "minimum": 0
        },
        "disallow_near_duplicate_within_same_rule_family": {
          "type": "boolean"
        }
      }
    },
    "lead_in": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_repeated_lead_in_count", "token_window"],
      "properties": {
        "max_repeated_lead_in_count": {
          "type": "integer",
          "minimum": 1
        },
        "token_window": {
          "type": "integer",
          "minimum": 3
        }
      }
    },
    "lexical_diversity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_unique_token_ratio"],
      "properties": {
        "min_unique_token_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
