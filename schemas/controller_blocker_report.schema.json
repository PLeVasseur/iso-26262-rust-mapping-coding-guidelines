{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Autonomous Controller Blocker Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "session_id",
    "status",
    "reason",
    "iteration",
    "max_iterations",
    "stall_window",
    "no_improvement_count",
    "remaining_deficits",
    "generated_at"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["blocked", "error"]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "iteration": {
      "type": "integer",
      "minimum": 0
    },
    "max_iterations": {
      "type": "integer",
      "minimum": 1
    },
    "stall_window": {
      "type": "integer",
      "minimum": 1
    },
    "no_improvement_count": {
      "type": "integer",
      "minimum": 0
    },
    "remaining_deficits": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "attempted_candidates": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    }
  }
}
