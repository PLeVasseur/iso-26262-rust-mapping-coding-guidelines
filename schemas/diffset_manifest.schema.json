{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Diffset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "diffset_id",
    "generated_at",
    "before_run_id",
    "after_run_id",
    "bundle_rel_path",
    "item_count",
    "counts",
    "artifact_sources"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "diffset_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "before_run_id": {
      "type": ["string", "null"]
    },
    "after_run_id": {
      "type": "string",
      "minLength": 1
    },
    "bundle_rel_path": {
      "type": "string",
      "minLength": 1
    },
    "item_count": {
      "type": "integer",
      "minimum": 0
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by_entity", "by_change_type", "by_severity"],
      "properties": {
        "by_entity": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_change_type": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_severity": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "artifact_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "null"]
          }
        },
        "after": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "null"]
          }
        }
      }
    }
  }
}
