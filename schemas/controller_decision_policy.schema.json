{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Controller Decision Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "enabled", "max_selected_candidates", "llm"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "max_selected_candidates": {
      "type": "integer",
      "minimum": 1
    },
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "fallback_to_deterministic", "command"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "fallback_to_deterministic": {
          "type": "boolean"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
