{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Controller Supervisor State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "session_id",
    "status",
    "loop_index",
    "max_loops",
    "runs",
    "lock_path",
    "started_at",
    "updated_at"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["running", "success", "blocked", "error"]
    },
    "loop_index": {
      "type": "integer",
      "minimum": 0
    },
    "max_loops": {
      "type": "integer",
      "minimum": 1
    },
    "last_exit_code": {
      "type": "integer"
    },
    "last_iteration_decision": {
      "type": "string"
    },
    "controller_status": {
      "type": "string"
    },
    "lock_path": {
      "type": "string",
      "minLength": 1
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "loop_index",
          "command",
          "return_code",
          "started_at",
          "completed_at",
          "controller_status",
          "iteration",
          "iteration_decision"
        ],
        "properties": {
          "loop_index": {
            "type": "integer",
            "minimum": 1
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "return_code": {
            "type": "integer"
          },
          "stdout": {
            "type": "string"
          },
          "stderr": {
            "type": "string"
          },
          "started_at": {
            "type": "string",
            "minLength": 1
          },
          "completed_at": {
            "type": "string",
            "minLength": 1
          },
          "controller_status": {
            "type": "string",
            "enum": ["running", "success", "blocked", "error"]
          },
          "iteration": {
            "type": "integer",
            "minimum": 0
          },
          "iteration_decision": {
            "type": "string"
          }
        }
      }
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    }
  }
}
