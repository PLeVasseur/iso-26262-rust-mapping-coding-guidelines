{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FLS Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generated_at", "source", "chapters", "paragraphs"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chapter_id", "title"],
        "properties": {
          "chapter_id": {
            "type": "string",
            "pattern": "^fls_ch_[a-z0-9_]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "paragraphs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fls_ref", "chapter_id", "label", "keywords"],
        "properties": {
          "fls_ref": {
            "type": "string",
            "pattern": "^fls_[a-z0-9_]+$"
          },
          "chapter_id": {
            "type": "string",
            "pattern": "^fls_ch_[a-z0-9_]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "keywords": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
