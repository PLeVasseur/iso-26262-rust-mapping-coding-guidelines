{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.3-codex",
  "autoupdate": false,
  "compaction": {
    "auto": true,
    "prune": true
  },
  "provider": {
    "openai": {
      "options": {
        "timeout": 600000
      }
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow"
  }
}
