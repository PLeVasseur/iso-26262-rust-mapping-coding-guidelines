{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.3-codex",
  "autoupdate": false,
  "compaction": {
    "auto": true,
    "prune": true
  },
  "provider": {
    "openai": {
      "options": {
        "timeout": 600000
      }
    }
  },
  "permission": {
    "edit": {
      "*": "allow",
      "/Users/pete.levasseur/personal/safety-critical-rust-coding-guidelines/**": "deny"
    },
    "bash": "allow",
    "external_directory": {
      "/Users/pete.levasseur/personal/safety-critical-rust-coding-guidelines/**": "allow"
    }
  }
}
